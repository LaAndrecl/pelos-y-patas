---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import NoticiaCard from '../components/NoticiaCard.astro';

const todas = await getCollection('noticias');
const ordenadas = todas.sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());

const destacada = ordenadas.find((n) => n.data.destacada) ?? ordenadas[0];
const resto = ordenadas.filter((n) => n.id !== destacada.id).slice(0, 6);

const fechaDestacada = destacada.data.fecha.toLocaleDateString('es-CL', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<Layout>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <span class="eyebrow hero-eyebrow">Portada</span>
        <h1>{destacada.data.titulo}</h1>
        <p class="hero-resumen">{destacada.data.resumen}</p>
        <div class="hero-meta">
          <span class="tag" data-categoria={destacada.data.categoria}>{destacada.data.categoria}</span>
          <span class="fecha">{fechaDestacada}</span>
        </div>
      </div>
      <a href={`/noticias/${destacada.id}`} class="hero-thumb" aria-hidden="true">
        {
          destacada.data.imagen ? (
            <img src={destacada.data.imagen} alt="" loading="eager" />
          ) : (
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#b3a98c" stroke-width="1.6">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <circle cx="8.5" cy="10" r="1.5" />
              <path d="M21 15l-5-5-11 9" />
            </svg>
          )
        }
      </a>
    </div>
  </section>

  <section class="container grid">
    {resto.map((n) => <NoticiaCard slug={n.id} titulo={n.data.titulo} categoria={n.data.categoria} fecha={n.data.fecha} imagen={n.data.imagen} />)}
  </section>
</Layout>

<style>
  .hero {
    background: var(--manila);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 24px;
    align-items: center;
    padding: 32px 24px;
  }
  .hero-eyebrow {
    color: var(--mustard-ink);
  }
  .hero h1 {
    font-size: 32px;
    line-height: 1.25;
    margin: 8px 0 12px;
  }
  .hero-resumen {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0 0 16px;
  }
  .hero-meta {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .hero-meta .fecha {
    font-size: 12px;
    color: var(--muted);
  }
  .hero-thumb {
    background: #e4dcc5;
    border-radius: 8px;
    height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .hero-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    padding: 32px 24px;
  }

  @media (max-width: 640px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-thumb {
      height: 160px;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
