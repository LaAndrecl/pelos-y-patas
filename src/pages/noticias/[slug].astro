---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const noticias = await getCollection('noticias');
  return noticias.map((n) => ({
    params: { slug: n.id },
    props: { entry: n },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const fecha = entry.data.fecha.toLocaleDateString('es-CL', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<Layout titulo={`${entry.data.titulo} — De Pelos y Patas`}>
  <article class="container articulo">
    {entry.data.imagen && <img class="portada" src={entry.data.imagen} alt="" />}
    <span class="tag" data-categoria={entry.data.categoria}>{entry.data.categoria}</span>
    <h1>{entry.data.titulo}</h1>
    <span class="fecha">{fecha}</span>
    <div class="cuerpo">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .articulo {
    padding: 32px 24px;
    max-width: 720px;
  }
  .portada {
    width: 100%;
    max-height: 360px;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 20px;
  }
  h1 {
    font-size: 28px;
    line-height: 1.3;
    margin: 12px 0 8px;
  }
  .fecha {
    font-size: 12px;
    color: var(--muted);
  }
  .cuerpo {
    margin-top: 24px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink);
  }
  .cuerpo :global(p) {
    margin: 0 0 1em;
  }
</style>
